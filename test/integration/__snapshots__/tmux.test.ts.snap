exports[`subcommands ls shows running markers; kill kills only its own session 1`] = `
"PROJECT  ROOT             LAYOUTS   STATUS
shop     ~/projects/shop  dev*, be  ● running (layout be)
blog     ~/projects/blog  default*  ● running (layout default)
"
`;

