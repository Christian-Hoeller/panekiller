{
  "name": "panekiller",
  "version": "0.1.1",
  "description": "Ends the pain of setting up tmux panes. One command per project.",
  "license": "MIT",
  "author": "Christian Hoeller",
  "type": "module",
  "bin": {
    "pk": "dist/pk.js"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Christian-Hoeller/panekiller.git"
  },
  "homepage": "https://github.com/Christian-Hoeller/panekiller#readme",
  "bugs": "https://github.com/Christian-Hoeller/panekiller/issues",
  "keywords": [
    "tmux",
    "cli",
    "developer-tools",
    "zsh",
    "workspace"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.9",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "bun scripts/test-unit.ts",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:e2e": "bun test test/e2e --timeout 120000",
    "bundle": "bun build src/cli.ts --target=node --minify-syntax --outfile dist/pk.js",
    "schema": "bun scripts/schema.ts",
    "demos": "bun scripts/demos.ts",
    "check": "bun scripts/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@clack/prompts": "1.9.0",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "jsonc-parser": "3.3.1",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ]
}
